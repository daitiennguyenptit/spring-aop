<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example.aop</groupId>
    <artifactId>spring-aop-handbook</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Spring AOP Handbook</name>
    <description>Tong hop kien thuc Spring AOP - moi bai toan la mot module demo</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <modules>
        <module>01-aop-basics</module>
        <module>02-audit-requestid</module>
        <module>03-performance-monitoring</module>
        <module>04-retry</module>
        <module>05-authorization</module>
        <module>06-pitfalls</module>
    </modules>

    <!-- Dependency dung chung cho moi module demo -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
